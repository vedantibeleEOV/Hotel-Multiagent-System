PROJECT_NAME="Hotel Operations AI"
VERSION="0.1.0"
DEBUG=True
HOST="0.0.0.0"
PORT=8000

# Docker PostgreSQL Database Configuration
POSTGRES_USER="your_postgres_user"
POSTGRES_PASSWORD="your_postgres_password"
POSTGRES_DB="hotel_operations_db"
DATABASE_URL="postgresql+psycopg2://your_postgres_user:your_postgres_password@localhost:5432/hotel_operations_db"

# Docker LLM / Local AI Service Settings
LLM_BASE_URL="http://localhost:11434/v1"
LLM_MODEL="llama3.2"
OPENAI_API_KEY="your_api_key"

# JWT Authentication Settings (JWT_SECRET must be at least 32 characters)
JWT_SECRET="your_secure_random_jwt_secret_key_at_least_32_chars"
JWT_EXPIRE_MINUTES=480

